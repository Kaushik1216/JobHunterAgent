# Copy this file to .env and fill in your values

# ── LLM Provider ────────────────────────────────────────────
# Options: lm_studio | ollama | openai
JOB_AGENT_LLM_PROVIDER=lm_studio
JOB_AGENT_LLM_BASE_URL=http://localhost:1234/v1
JOB_AGENT_LLM_MODEL=qwen2.5-7b-instruct
JOB_AGENT_LLM_TEMPERATURE=0.0
JOB_AGENT_LLM_TIMEOUT=180

# ── Ollama (if using ollama provider) ───────────────────────
JOB_AGENT_OLLAMA_BASE_URL=http://localhost:11434
JOB_AGENT_OLLAMA_MODEL=qwen2.5:3b-instruct

# ── Search ──────────────────────────────────────────────────
# Comma-separated portal IDs: linkedin, indeed, naukri, glassdoor, greenhouse, lever
JOB_AGENT_SEARCH_PORTALS=linkedin
JOB_AGENT_SEARCH_MAX_DAYS=7
JOB_AGENT_SEARCH_MAX_RESULTS=5

# ── Dashboard ───────────────────────────────────────────────
JOB_AGENT_DASHBOARD_HOST=127.0.0.1
JOB_AGENT_DASHBOARD_PORT=8000

# ── Logging ─────────────────────────────────────────────────
JOB_AGENT_LOG_LEVEL=INFO
JOB_AGENT_LOG_FORMAT=console
