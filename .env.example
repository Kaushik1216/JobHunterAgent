# LLM Provider Configuration (lm_studio, ollama, openai)
JOB_AGENT_LLM_PROVIDER=lm_studio
JOB_AGENT_LLM_BASE_URL=http://localhost:1234/v1
JOB_AGENT_LLM_MODEL=qwen3.5-2b
JOB_AGENT_LLM_TEMPERATURE=0.0
JOB_AGENT_LLM_TIMEOUT=60

# Optional Ollama fallback
JOB_AGENT_OLLAMA_BASE_URL=http://localhost:11434
JOB_AGENT_OLLAMA_MODEL=qwen2.5:3b-instruct
SEARCH_JITTER_MIN=1.0
SEARCH_JITTER_MAX=3.0
SEARCH_MAX_RESULTS=10
FIT_SCORE_THRESHOLD=0.7
DB_PATH=jobs_vault.db
CRITERIA_PATH=criteria.yaml
OUTPUT_PATH=jobs_output.md
LOG_LEVEL=INFO
LOG_FORMAT=json
